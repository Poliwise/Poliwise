# ===========================================
# Email Configuration (SMTP)
# ===========================================
# Gmail SMTP Settings:
# - EMAIL_USER: Your Gmail address
# - EMAIL_APP_PASSWORD: App password from Google Account settings
#   (Enable 2FA first, then create App Password at: myaccount.google.com -> Security -> App passwords)
# - EMAIL_ENABLED: Set to 'true' to enable email sending, 'false' to disable
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_ENABLED=true

# ===========================================
# RabbitMQ / CloudAMQP Configuration
# ===========================================
RABBITMQ_HOST=your-rabbitmq-host.com
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=your-username
RABBITMQ_PASSWORD=your-password
RABBITMQ_VHOST=your-vhost

# ===========================================
# Spring Boot Configuration
# ===========================================
SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres?schema=core
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-db-password

# ===========================================
# Default Admin Account
# ===========================================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@poliwise.local
ADMIN_PASSWORD=Admin@123

# ===========================================
# Auth Service JWT Configuration
# ===========================================
AUTH_JWT_SECRET=poliwise-jwt-secret-key-must-be-at-least-256-bits-long-for-hs256
AUTH_JWT_ISSUER=poliwise-auth-service
AUTH_ACCESS_TOKEN_TTL=PT15M
AUTH_REFRESH_TOKEN_TTL=P7D
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_DURATION=PT15M
