# ===========================================
# Spring Boot Profile Selection
# ===========================================
# Use 'local' for Docker Compose development
# Use 'cloud' for production deployment
# ===========================================
SPRING_PROFILES_ACTIVE=local

# ===========================================
# Local Environment Variables (Docker Compose)
# ===========================================
LOCAL_DB_USERNAME=poliwise
LOCAL_DB_PASSWORD=
LOCAL_RABBITMQ_HOST=rabbitmq
LOCAL_RABBITMQ_PORT=5672
LOCAL_RABBITMQ_USERNAME=poliwise
LOCAL_RABBITMQ_PASSWORD=
LOCAL_RABBITMQ_VHOST=/

# ===========================================
# Cloud Environment Variables (Production)
# ===========================================
CLOUD_DB_URL=
CLOUD_DB_USERNAME=
CLOUD_DB_PASSWORD=
CLOUD_RABBITMQ_HOST=
CLOUD_RABBITMQ_PORT=5672
CLOUD_RABBITMQ_USERNAME=
CLOUD_RABBITMQ_PASSWORD=
CLOUD_RABBITMQ_VHOST=

# ===========================================
# Default Admin Account
# ===========================================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@poliwise.local
ADMIN_PASSWORD=

# ===========================================
# Auth Service JWT Configuration
# ===========================================
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=poliwise-auth-service
AUTH_ACCESS_TOKEN_TTL=PT15M
AUTH_REFRESH_TOKEN_TTL=P7D
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_DURATION=PT15M