# ===========================================
# RabbitMQ / CloudAMQP Configuration
# ===========================================
RABBITMQ_HOST=fuji.lmq.cloudamqp.com
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=bjzoliga
RABBITMQ_PASSWORD=YOUR_PASSWORD_HERE
RABBITMQ_VHOST=bjzoliga

# ===========================================
# Spring Boot Configuration
# ===========================================
SPRING_PROFILES_ACTIVE=cloud
SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/db?schema=core&pgbouncer=true
SPRING_DATASOURCE_USERNAME=your_username
SPRING_DATASOURCE_PASSWORD=your_password

# ===========================================
# Default Admin Account
# ===========================================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@poliwise.local
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_HERE

# ===========================================
# Auth Service JWT Configuration
# ===========================================
AUTH_JWT_SECRET=your-256-bit-secret-key-here
AUTH_JWT_ISSUER=poliwise-auth-service
AUTH_ACCESS_TOKEN_TTL=PT15M
AUTH_REFRESH_TOKEN_TTL=P7D
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_DURATION=PT15M
