# ===========================================
# JWT Configuration (must match auth-service)
# ===========================================
POLIWISE_JWT_SECRET=your-jwt-secret-key-at-least-256-bits-long
POLIWISE_JWT_ISSUER=poliwise-auth-service

# ===========================================
# RabbitMQ / CloudAMQP Configuration
# ===========================================
RABBITMQ_HOST=your-rabbitmq-host
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=your-username
RABBITMQ_PASSWORD=your-password
RABBITMQ_VHOST=your-vhost

# ===========================================
# Spring Boot Configuration
# ===========================================
SPRING_PROFILES_ACTIVE=cloud
SPRING_DATASOURCE_URL=jdbc:postgresql://your-supabase-host:5432/postgres?schema=analytics&pgbouncer=true
SPRING_DATASOURCE_USERNAME=your-username
SPRING_DATASOURCE_PASSWORD=your-password
