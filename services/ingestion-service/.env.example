HOST=0.0.0.0
PORT=8088
LOG_LEVEL=info

# Database (Supabase Cloud) - Python uses asyncpg protocol
DATABASE_URL=
DATABASE_SCHEMA=knowledge

# RabbitMQ (CloudAMQP) - Python format
RABBITMQ_URL=
RABBITMQ_EXCHANGE=poliwise.events

# MinIO (Native testing expects local minio to run alongside from compsose)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=false

# LitServe local
LITSERVE_EMBEDDING_URL=http://localhost:8001
LITSERVE_RERANKER_URL=http://localhost:8002

# LLM API
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Chunking
CHUNKING_PARENT_SIZE=1500
CHUNKING_CHILD_SIZE=400
CHUNKING_CHILD_OVERLAP=80
CHUNKING_DEFAULT_STRATEGY=parent_child

# OCR Fallback
OCR_FALLBACK_MIN_TEXT_LENGTH=50
OCR_FALLBACK_MIN_IMAGE_COUNT=1
OCR_LANGUAGE=eng+vie