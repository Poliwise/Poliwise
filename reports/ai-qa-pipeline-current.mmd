flowchart TD
    User(["User Query"]) --> K["Keyword Safety Filter<br/>Regex toxic/jailbreak patterns"]

    K --> KHit{"Matched?"}
    KHit -- "Yes" --> Block["BLOCKED<br/>Return: inappropriate content"]
    Block --> End(["Response"])

    KHit -- "No" --> Lang{"Vietnamese input?"}
    Lang -- "Yes" --> VI["Safety LLM<br/>llama-3.1-8b-instant"]
    Lang -- "No" --> EN["Safety LLM<br/>llama-prompt-guard-2-86m"]

    VI --> Safe{"Safe?"}
    EN --> Safe
    Safe -- "No" --> Block

    Safe -- "Yes" --> Intent["Intent Classifier<br/>llama-3.1-8b-instant<br/>query + recent history"]
    Intent --> Type{"Intent"}

    Type -- "SIMPLE" --> Simple["Simple Responder<br/>llama-3.1-8b-instant<br/>No RAG, no sources"]
    Simple --> Save2["Save assistant message<br/>has_sources = false"]
    Save2 --> Title2["Background title generation<br/>llama-3.1-8b-instant"]
    Save2 --> Return2["OK<br/>Direct response"]
    Return2 --> End

    Type -- "COMPLEX / classifier error" --> Refine["Query Refiner<br/>llama-3.1-8b-instant<br/>Translate + rewrite + expand"]
    Refine --> Search["Hybrid Search<br/>BAAI/bge-m3 via TEI + BM25 + RRF<br/>ACL role/department filter"]

    Search --> Rerank{"Reranker enabled?"}
    Rerank -- "No (default)" --> Gap["Knowledge Gap Detection<br/>similarity threshold"]
    Rerank -- "Yes" --> RR["External reranker<br/>configured but off by default"]
    RR --> Gap

    Gap --> Prompt["Prompt Builder<br/>query + chunks + history"]
    Prompt --> Registry["Model Registry<br/>Default: local/qwen3-8b<br/>Options/Fallback: Groq Qwen3-32B,<br/>Groq Llama 3.3 70B, Gemini Flash,<br/>OpenRouter Mistral"]

    Registry --> Gen["Generate / Stream response"]
    Gen --> Strip["Strip think tags if present"]
    Strip --> Sources["Build document sources from chunks"]
    Sources --> Save3["Save assistant message<br/>sources + confidence + model_used"]

    Save3 --> Title3["Background title generation"]
    Save3 --> GapEvent{"Knowledge gap detected?"}
    GapEvent -- "Yes" --> Publish["Publish RabbitMQ event<br/>unanswered.question"]
    GapEvent -- "No" --> Return3["OK<br/>Response + sources"]
    Publish --> Return3
    Return3 --> End

    classDef danger fill:#fee2e2,stroke:#ef4444,stroke-width:2px,color:#991b1b;
    classDef success fill:#dcfce7,stroke:#22c55e,stroke-width:2px,color:#166534;
    classDef warning fill:#fef08a,stroke:#eab308,stroke-width:2px,color:#854d0e;
    classDef layer fill:#f0f9ff,stroke:#0ea5e9,stroke-width:2px,color:#0369a1;

    Block:::danger
    Return2:::success
    Return3:::success
    Intent:::layer
    Search:::layer
    Registry:::layer
    Publish:::warning
